# F1 Race Control Matrix - example ESPHome secrets
#
# Copy these entries to your local secrets.yaml and replace all placeholders.
# Never commit your real secrets.yaml.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate a unique 32-byte Base64 key for every device.
# Example command:
#   openssl rand -base64 32
api_encryption_key: "GENERATE_A_UNIQUE_KEY_FOR_THIS_DEVICE"
